# Copy to ripshelf.env next to the checkout (gitignored) or, in the container, /data/ripshelf.env.
# Settings changed in the UI are stored in <data>/settings.json and win over these.
RIPSHELF_TMDB_API_KEY=
# RIPSHELF_TVDB_API_KEY=
RIPSHELF_MAKEMKV_KEY=
# RIPSHELF_DATA_DIR=data
# RIPSHELF_SCRATCH_DIR=scratch
# RIPSHELF_LIBRARY_DIR=library
# RIPSHELF_PORT=8380
# Notifications and the media server refreshes stay off until these are set.
# RIPSHELF_PUBLIC_URL=http://192.168.1.10:8380
# RIPSHELF_EMBY_URL=
# RIPSHELF_EMBY_API_KEY=
# RIPSHELF_JELLYFIN_URL=
# RIPSHELF_JELLYFIN_API_KEY=
# RIPSHELF_PLEX_URL=
# RIPSHELF_PLEX_TOKEN=
# RIPSHELF_PUSHOVER_USER_KEY=
# RIPSHELF_PUSHOVER_APP_TOKEN=
